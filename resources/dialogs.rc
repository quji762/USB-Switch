#include <winres.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 354, 250
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_DIALOG_HEADER, "Static", SS_OWNERDRAW, 0, 0, 354, 44
    CONTROL "", IDC_SET_BEHAVIOR, "Static", SS_OWNERDRAW, 14, 56, 94, 34
    AUTOCHECKBOX "", IDC_SET_STARTUP, 114, 58, 228, 13, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SET_NOTIFY, 114, 80, 228, 13, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SET_CONFIRM, 114, 102, 228, 13, WS_TABSTOP
    CONTROL "", IDC_SET_DIVIDER, "Static", SS_OWNERDRAW, 14, 123, 326, 1
    CONTROL "", IDC_SET_FOOTER, "Static", SS_OWNERDRAW, 0, 212, 354, 1
    CONTROL "", IDC_SET_INPUT, "Static", SS_OWNERDRAW, 14, 132, 94, 34
    LTEXT "", IDC_SET_LANG_LABEL, 114, 136, 98, 14
    COMBOBOX IDC_SET_LANG, 215, 133, 125, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_SET_KEY_LABEL, 114, 162, 98, 14
    COMBOBOX IDC_SET_KEY, 215, 159, 125, 108, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_SET_THEME_LABEL, 114, 188, 98, 14
    COMBOBOX IDC_SET_THEME, 215, 185, 125, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Save", IDOK, 220, 222, 56, 19
    PUSHBUTTON "Cancel", IDCANCEL, 282, 222, 58, 19
END

IDD_ABOUT DIALOGEX 0, 0, 292, 154
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_DIALOG_HEADER, "Static", SS_OWNERDRAW, 0, 0, 292, 44
    LTEXT "", IDC_ABOUT_DESC, 14, 56, 264, 50, SS_NOPREFIX
    CONTROL "", IDC_ABOUT_WEBSITE, "SysLink", WS_TABSTOP, 14, 108, 264, 17
    DEFPUSHBUTTON "OK", IDOK, 222, 129, 58, 18
END

IDD_ALIAS DIALOGEX 0, 0, 292, 142
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Device alias"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_DIALOG_HEADER, "Static", SS_OWNERDRAW, 0, 0, 292, 44
    LTEXT "", IDC_ALIAS_HINT, 14, 54, 264, 34, SS_NOPREFIX
    EDITTEXT IDC_ALIAS_NAME, 14, 90, 264, 16, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 160, 116, 56, 18
    PUSHBUTTON "Cancel", IDCANCEL, 222, 116, 58, 18
END

IDD_OPEN_FILES DIALOGEX 0, 0, 358, 226
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open files"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_DIALOG_HEADER, "Static", SS_OWNERDRAW, 0, 0, 358, 44
    EDITTEXT IDC_FILES_TEXT, 12, 54, 334, 136, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Retry", IDRETRY, 200, 199, 78, 18
    DEFPUSHBUTTON "Close", IDCANCEL, 284, 199, 62, 18
END

    AUTOCHECKBOX "", IDC_SMART_TEMP, 18, 56, 246, 14, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SMART_HOURS, 18, 74, 246, 14, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SMART_CYCLES, 18, 92, 246, 14, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SMART_REALLOC, 18, 110, 246, 14, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SMART_PENDING, 18, 128, 246, 14, WS_TABSTOP
    LTEXT "", IDC_SMART_NOTE, 18, 148, 246, 28, SS_NOPREFIX
    DEFPUSHBUTTON "Save", IDOK, 148, 184, 56, 18
    PUSHBUTTON "Cancel", IDCANCEL, 210, 184, 56, 18
END

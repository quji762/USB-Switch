// Dialog templates. All visible text is set at runtime from the i18n table so
// the same binary can serve every language (see src/i18n/Strings.cpp).

#include <winres.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// About
/////////////////////////////////////////////////////////////////////////////

// 236x106: the OK button (y=90, height=14) ends at 104, so it needs 106 to
// stay inside the client area.
IDD_ABOUT DIALOGEX 0, 0, 236, 106
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT    "",              IDC_ABOUT_APPNAME,  14,  10, 208, 10
    // Read-only multiline edit: static text does not word-wrap, this does.
    EDITTEXT IDC_ABOUT_DESC,                  14,  26, 208, 44, ES_MULTILINE | ES_READONLY | WS_VSCROLL
    LTEXT    "",              IDC_ABOUT_WEBSITE,  14,  76, 208, 10
    DEFPUSHBUTTON "OK",       IDOK,               178, 90,  44, 14
END

/////////////////////////////////////////////////////////////////////////////
// Settings
/////////////////////////////////////////////////////////////////////////////

// 224x100: the buttons (y=84, height=14) end at 98.
IDD_SETTINGS DIALOGEX 0, 0, 224, 124
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX "",          IDC_SET_STARTUP,     12,  8, 200, 10
    AUTOCHECKBOX "",          IDC_SET_NOTIFY,      12, 22, 200, 10
    AUTOCHECKBOX "",          IDC_SET_CONFIRM,     12, 36, 200, 10
    LTEXT    "",              IDC_SET_LANG_LABEL,  12, 52,  40, 10
    COMBOBOX IDC_SET_LANG,                      56, 50, 156, 44, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_SET_KEY_LABEL, 12, 70, 84, 12
    COMBOBOX IDC_SET_KEY, 98, 68, 114, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT    "",              IDC_SET_NOTE,        12, 91, 200, 16
    DEFPUSHBUTTON "OK",       IDOK,                98, 107,  44, 14
    PUSHBUTTON "Cancel",      IDCANCEL,           148, 107,  44, 14
END

IDD_ALIAS DIALOGEX 0, 0, 260, 96
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Device alias"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "", IDC_ALIAS_HINT, 10, 8, 240, 36, SS_NOPREFIX
    EDITTEXT IDC_ALIAS_NAME, 10, 46, 240, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 151, 73, 47, 14
    PUSHBUTTON "Cancel", IDCANCEL, 203, 73, 47, 14
END
